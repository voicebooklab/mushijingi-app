<%- include('partials/head', { title: 'コレクション状況' }) %>
<h1>コレクション状況</h1>

<div class="card-box overall-box">
  <div class="progress-row">
    <strong>全弾合計</strong>
    <span>登録 <%= overall.registered %> / 全<%= overall.total_cards %>枚　残り<%= overall.remaining %>枚</span>
  </div>
  <div class="progress-bar-bg">
    <div class="progress-bar-fill" style="width: <%= overall.total_cards > 0 ? Math.min(100, Math.round(overall.registered / overall.total_cards * 100)) : 0 %>%;"></div>
  </div>
  <% if (overall.unsetSets.length > 0) { %>
    <div class="overall-note">第<%= overall.unsetSets.join('・第') %>弾は総枚数が未設定のため、この合計には含めていません</div>
  <% } %>
</div>

<h2>弾ごとの内訳</h2>
<% progress.forEach(function(p) { %>
  <div class="card-box">
    <div class="progress-row">
      <strong>第<%= p.set_no %>弾</strong>
      <% if (p.total_cards > 0) { %>
        <span>登録 <%= p.registered %> / 全<%= p.total_cards %>枚　残り<%= p.remaining %>枚</span>
      <% } else { %>
        <span>登録 <%= p.registered %>枚（総枚数未設定）</span>
      <% } %>
    </div>
    <div class="progress-bar-bg">
      <div class="progress-bar-fill" style="width: <%= p.total_cards > 0 ? Math.min(100, Math.round(p.registered / p.total_cards * 100)) : 0 %>%;"></div>
    </div>
  </div>
<% }); %>
<a class="btn" href="/cards/new">カードを登録する</a>
<%- include('partials/foot', { active: 'home' }) %>
