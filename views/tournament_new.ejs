<%- include('partials/head', { title: '戦績を記録' }) %>
<h1>戦績を記録</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="POST" action="/tournaments">
  <div>
    <label>大会日</label>
    <input type="date" name="date" value="<%= form.date || '' %>" required>
  </div>
  <div>
    <label>大会名（任意）</label>
    <input type="text" name="name" value="<%= form.name || '' %>">
  </div>
  <div>
    <label>使用デッキ</label>
    <select name="deck_id">
      <option value="">選択なし</option>
      <% decks.forEach(function(d) { %>
        <option value="<%= d.id %>" <%= String(form.deck_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
      <% }); %>
    </select>
  </div>
  <div>
    <label>勝敗</label>
    <select name="result">
      <option value="">選択してください</option>
      <option value="勝ち" <%= form.result === '勝ち' ? 'selected' : '' %>>勝ち</option>
      <option value="負け" <%= form.result === '負け' ? 'selected' : '' %>>負け</option>
      <option value="引き分け" <%= form.result === '引き分け' ? 'selected' : '' %>>引き分け</option>
    </select>
  </div>
  <div>
    <label>メモ</label>
    <textarea name="memo"><%= form.memo || '' %></textarea>
  </div>
  <button type="submit">記録する</button>
</form>
<%- include('partials/foot', { active: 'tournaments' }) %>
